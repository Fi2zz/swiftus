{
  "name": "aws-source",
  "kind": "aws-source",
  "cases": [
    {
      "scenario": "refresh",
      "label": "POST / GetSecretValue + SigV4 头，SecretString 为 JSON 时展开",
      "input": {
        "status": 200,
        "body": "{\"SecretString\":\"{\\\"ARK_API_KEY\\\":\\\"aws-key\\\",\\\"DEEPSEEK_API_KEY\\\":{\\\"value\\\":\\\"ds-key\\\"}}\"}",
        "networkError": false
      },
      "expect": {
        "result": {
          "request": {
            "sent": true,
            "method": "POST",
            "url": "https://secretsmanager.us-east-1.amazonaws.com/",
            "contentType": "application/x-amz-json-1.1",
            "token": null,
            "target": "secretsmanager.GetSecretValue",
            "hasSessionToken": false,
            "contentSha256": "36865045941a72179e364e6572404e1419b03fe13d800fc97dd5fc68c12aa5ba",
            "amzDateFormat": true,
            "authorization": {
              "present": true,
              "parsed": true,
              "algorithm": "AWS4-HMAC-SHA256",
              "accessKey": "AKIDEXAMPLE",
              "dateStampFormat": true,
              "region": "us-east-1",
              "service": "secretsmanager",
              "scopeSuffix": "us-east-1/secretsmanager/aws4_request",
              "signedHeaders": [
                "content-type",
                "host",
                "x-amz-content-sha256",
                "x-amz-date",
                "x-amz-target"
              ],
              "signatureLength": 64
            },
            "body": "{\"SecretId\":\"conatus/llm\"}"
          },
          "snapshot": {
            "ARK_API_KEY": {
              "value": "aws-key",
              "expiresAt": null
            },
            "DEEPSEEK_API_KEY": {
              "value": "ds-key",
              "expiresAt": null
            }
          },
          "keys": [
            "ARK_API_KEY",
            "DEEPSEEK_API_KEY"
          ],
          "code": ""
        }
      }
    },
