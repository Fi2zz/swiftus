{
  "name": "search-web-tools",
  "kind": "search-web-tools",
  "cases": [
    {
      "scenario": "web-search",
      "label": "web_search：结果文本与结构化值、空结果、失败时列出未配置的源",
      "input": {
        "query": "swift",
        "limit": 2,
        "results": [
          {
            "title": "标题一",
            "url": "https://a.example/1",
            "snippet": "摘要一"
          },
          {
            "title": "标题二",
            "url": "https://a.example/2"
          }
        ],
        "statuses": [
          {
            "name": "a",
            "available": true
          },
          {
            "name": "tavily",
            "available": false,
            "reason": "缺少 TAVILY_API_KEY"
          },
          {
            "name": "exa",
            "available": false,
            "reason": "缺少 EXA_API_KEY"
          }
        ]
      },
      "expect": {
        "hitText": "搜索 \"swift\" 的结果：\n1. 标题一\n   https://a.example/1\n   摘要一\n2. 标题二\n   https://a.example/2",
        "hitValue": [
          {
            "title": "标题一",
            "url": "https://a.example/1",
            "snippet": "摘要一"
          },
          {
            "title": "标题二",
            "url": "https://a.example/2",
            "snippet": ""
          }
        ],
        "hitFailed": false,
        "emptyText": "未找到与 \"swift\" 相关的结果",
        "emptyValue": [],
        "emptyFailed": false,
        "failedText": "无法联网：所有搜索源都不可用。\n所有搜索 provider 都失败：a: SearchException: boom\n未配置的搜索源：tavily（缺少 TAVILY_API_KEY）；exa（缺少 EXA_API_KEY）",
        "failedError": "SEARCH_UNAVAILABLE",
        "failedMessage": "所有搜索 provider 都失败：a: SearchException: boom"
      }
    },
    {
      "scenario": "fetch-url",
      "label": "fetch_url：正文与 {url, format}、非 http(s) → INVALID_URL、抓取失败 → FETCH_FAILED",
      "input": {
        "url": "https://example.com/p",
        "maxChars": 20000,
        "response": {
          "status": 200,
          "body": "<p>正文 &amp; 摘要</p>"
        },
        "invalid": [
          "ftp://x/y",
          "不是链接"
        ],
        "failing": {
          "url": "https://example.com/gone",
          "status": 404
        }
      },
      "expect": {
        "okText": "正文 & 摘要",
        "okValue": {
          "url": "https://example.com/p",
          "format": "text"
        },
        "okFailed": false,
        "badSchemeText": "仅支持 http/https 链接：\"ftp://x/y\"",
        "badSchemeCode": "INVALID_URL",
        "unparseableText": "仅支持 http/https 链接：\"不是链接\"",
        "unparseableCode": "INVALID_URL",
        "failedText": "无法联网：抓取 https://example.com/gone 失败。HTTP 404",
        "failedCode": "FETCH_FAILED",
        "failedMessage": "HTTP 404"
      }
    }
  ]
}
