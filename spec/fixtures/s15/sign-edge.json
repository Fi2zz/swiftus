        "payload": "",
        "timestamp": "2024-01-01T00:00:00.000Z"
      },
      "expect": {
        "headers": {
          "Authorization": "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20240101/us-east-1/secretsmanager/aws4_request, SignedHeaders=content-type;host;x-amz-content-sha256;x-amz-date;x-amz-target, Signature=fed7103760de56b85584489cdf3f31ee1da052ec42c210539b8d0f9bf13fb9e1",
