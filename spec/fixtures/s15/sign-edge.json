          "X-Amz-Date": "20240101T000000Z",
          "X-Amz-Target": "secretsmanager.GetSecretValue"
        },
        "authorization": {
          "algorithm": "AWS4-HMAC-SHA256",
          "accessKey": "AKIDEXAMPLE",
          "scope": "20240101/us-east-1/secretsmanager/aws4_request",
          "signedHeaders": [
            "content-type",
            "host",
            "x-amz-content-sha256",
            "x-amz-date",
            "x-amz-target"
          ],
          "signature": "fed7103760de56b85584489cdf3f31ee1da052ec42c210539b8d0f9bf13fb9e1"
        },
        "hostInSignedHeaders": true,
        "hasHostHeader": false
      }
    },
